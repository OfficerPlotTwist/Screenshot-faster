<Window x:Class="ScreenshotFaster.SavedToast"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual">
    <Border Background="#F21A1D21" CornerRadius="10" Padding="18,14"
            BorderBrush="#33FFFFFF" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.5" Color="Black" />
        </Border.Effect>
        <StackPanel Orientation="Horizontal" MaxWidth="560">
            <TextBlock Text="&#x2713;" Foreground="#FF3DDC84" FontSize="20"
                       FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,12,0" />
            <TextBlock x:Name="MessageText" Foreground="#FFF0F0F0"
                       FontFamily="Segoe UI" FontSize="13.5" TextWrapping="Wrap"
                       VerticalAlignment="Center" />
        </StackPanel>
    </Border>
</Window>
