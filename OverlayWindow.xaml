<Window x:Class="ScreenshotFaster.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Cursor="Cross"
        Focusable="True">
    <Canvas x:Name="Root" Background="Transparent">
        <!-- Dim layer with an EvenOdd "hole" punched out for the selection. -->
        <Path x:Name="DimPath" Fill="#73000000" />

        <!-- Selection outline -->
        <Rectangle x:Name="SelRect"
                   Stroke="#FF3DDC84" StrokeThickness="1.5"
                   Visibility="Collapsed" />

        <!-- Mode / hint badge -->
        <Border x:Name="HintBadge"
                Background="#E6101418" CornerRadius="8"
                Padding="14,8" BorderBrush="#33FFFFFF" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="ModeDot" Width="11" Height="11"
                         VerticalAlignment="Center" Margin="0,0,9,0" />
                <TextBlock x:Name="HintText"
                           Foreground="#FFEFEFEF" FontSize="13"
                           FontFamily="Segoe UI" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- Live size readout near the selection -->
        <Border x:Name="SizeBadge" Background="#E6101418" CornerRadius="4"
                Padding="6,2" Visibility="Collapsed">
            <TextBlock x:Name="SizeText" Foreground="#FFEFEFEF"
                       FontSize="12" FontFamily="Consolas" />
        </Border>
    </Canvas>
</Window>
