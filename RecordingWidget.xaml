<Window x:Class="ScreenshotFaster.RecordingWidget"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        Cursor="SizeAll"
        ToolTip="Click to stop · drag to move">
    <Grid Width="76" Height="76">
        <!-- soft glow ring -->
        <Ellipse Width="76" Height="76" Fill="#33FF4D4D" x:Name="Glow">
            <Ellipse.RenderTransform>
                <ScaleTransform x:Name="GlowScale" CenterX="38" CenterY="38" ScaleX="1" ScaleY="1" />
            </Ellipse.RenderTransform>
        </Ellipse>
        <!-- main red record button -->
        <Ellipse Width="54" Height="54" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#FFFF6B6B" Offset="0" />
                    <GradientStop Color="#FFE63030" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>
        <Ellipse Width="54" Height="54" HorizontalAlignment="Center" VerticalAlignment="Center"
                 Stroke="#FFFFFFFF" StrokeThickness="2" Opacity="0.85" />
        <!-- white stop square -->
        <Rectangle Width="17" Height="17" RadiusX="3" RadiusY="3"
                   Fill="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Grid>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                    <DoubleAnimation Storyboard.TargetName="GlowScale"
                                     Storyboard.TargetProperty="ScaleX"
                                     From="0.85" To="1.12" Duration="0:0:0.9" />
                    <DoubleAnimation Storyboard.TargetName="GlowScale"
                                     Storyboard.TargetProperty="ScaleY"
                                     From="0.85" To="1.12" Duration="0:0:0.9" />
                    <DoubleAnimation Storyboard.TargetName="Glow"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0.9" To="0.35" Duration="0:0:0.9" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>
</Window>
